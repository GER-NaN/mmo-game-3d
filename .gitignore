# Godot 4+ specific ignores
.godot/
/android/

# .NET build output
bin/
obj/
# ...but the Terrain3D add-on's native libraries are part of the game
!/addons/terrain_3d/bin/
# The editor's copy of a library it holds open
/addons/terrain_3d/bin/~*

# Private agent instructions
CLAUDE.local.md
# The old repo's private instructions, kept for reference
CLAUDE.local.*.md

# Test results
TestResults/

# Art: kept out of git, placed by hand on each machine (see assets/README.md)
/assets/*
!/assets/README.md
# The ground textures' import settings (mipmaps, compression) that Terrain3D needs
!/assets/terrain/
/assets/terrain/*
!/assets/terrain/*.png.import

# Native (C++) build output; the DLLs land in native/bin/, ignored with bin/ above
/native/build/

# Python bytecode
__pycache__/

# The wiki site, built by scripts/wiki-publish.ps1
/tools/wiki/site/


# Pictures from the old bot runs, on this machine only
/docs/engineering/bot-shots/

# Bot runs: each run's events, logs and pictures (game/bots/overseer)
/bot-runs/
/graphics-saves/
